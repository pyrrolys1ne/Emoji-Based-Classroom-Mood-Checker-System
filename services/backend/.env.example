MOOD_APP_NAME=Classroom Mood API
MOOD_DATABASE_URL=postgresql+psycopg://mood:mood_local_only@127.0.0.1:5432/mood
MOOD_DATABASE_CONNECT_TIMEOUT=2
MOOD_DATABASE_POOL_SIZE=5
MOOD_DATABASE_MAX_OVERFLOW=5
MOOD_DATABASE_POOL_TIMEOUT=10
MOOD_CORS_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:5174"]
MOOD_USER_SESSION_TTL_SECONDS=28800
MOOD_WS_TICKET_TTL_SECONDS=30
# 配置独立 AI 服务令牌，不能使用用户令牌保留前缀 usr_。空值禁用 AI 入库认证。
MOOD_AI_SERVICE_TOKEN=
# 仅供正式后端代理 AI 内部控制接口，须与 AI 服务的 AI_CONTROL_TOKEN 相同。
MOOD_AI_CONTROL_TOKEN=
MOOD_AI_BASE_URL=http://127.0.0.1:8001
# 后端独立过滤阈值；低于阈值返回过滤回执，等于阈值可入库。
MOOD_AI_MIN_CONFIDENCE=0.5
# 仅在与正式数据隔离的开发数据库开启，模拟记录始终保留标记。
MOOD_ALLOW_SIMULATED_AI=false
