AI_BACKEND_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
AI_CONTROL_TOKEN=
AI_OUTBOX_PATH=.local/ai-outbox.sqlite
# 可选 AI_DATA_DIR 指定公开样本和分析报告目录；默认使用仓库 .local。
# 课堂、摄像头编号、采样间隔和置信度通过受保护的 /control/start 配置。
# 服务自动读取同目录 .env；已有进程环境变量优先。联调脚本自动注入临时令牌。
# 仅在服务端配置，禁止使用 VITE_ 前缀或提交真实密钥。
DEEPSEEK_API_KEY=
# 公开样本识图使用官方 deepseek-flash 模型，不需要本地模型依赖。
