POSTGRES_USER=mood
POSTGRES_PASSWORD=mood_local_only
MOOD_AI_SERVICE_TOKEN=
MOOD_AI_CONTROL_TOKEN=
MOOD_USER_SESSION_TTL_SECONDS=28800
MOOD_WS_TICKET_TTL_SECONDS=30
MOOD_REALTIME_POLL_SECONDS=1
