{
  "name": "classroom-mood-checker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:admin": "npm run dev --workspace @mood/admin",
    "dev:client": "npm run dev --workspace @mood/client",
    "dev:integration": "node scripts/dev-integration.mjs",
    "test:admin": "npm run test --workspace @mood/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:client": "npm run test --workspace @mood/client"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
